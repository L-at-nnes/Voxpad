{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voxpad",
  "version": "0.3.0",
  "identifier": "rocks.voxpad.app",
  "build": {
    "frontendDist": "../ui-src/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Voxpad",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' asset: https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
